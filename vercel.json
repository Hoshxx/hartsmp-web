{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/bluemap", "destination": "/api/bluemap" },
    { "source": "/bluemap/", "destination": "/api/bluemap" },
    { "source": "/bluemap/:path+", "destination": "/api/bluemap?path=:path+" }
  ]
}
